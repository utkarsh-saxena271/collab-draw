# HTTP API configuration. Copy to `.env` before running `bun run dev`.

# 5001 avoids macOS AirPlay Receiver, which listens on port 5000.
PORT=5001
BUN_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/collabdraw
JWT_SECRET=replace-with-a-long-random-secret
# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:3000
